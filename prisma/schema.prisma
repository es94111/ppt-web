generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  GUEST
}

enum Visibility {
  PRIVATE
  AUTHENTICATED
  PASSWORD
  PUBLIC
  UNLISTED
}

enum SourceType {
  MARKDOWN
  PPTX
}

enum DeckStatus {
  READY
  PROCESSING
  FAILED
}

enum CollaboratorRole {
  VIEWER
  COMMENTER
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(GUEST)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  decks         Deck[]
  viewLogs      ViewLog[]
  collaborators DeckCollaborator[]
  comments      SlideComment[]
  favorites     Favorite[]
  shareLinks    ShareLink[]
  accounts      Account[]
  sessions      Session[]
}

model Deck {
  id           String     @id @default(cuid())
  title        String
  description  String?
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility   Visibility @default(PRIVATE)
  sourceType   SourceType @default(MARKDOWN)
  status       DeckStatus @default(READY)
  sourceFile   String?
  passwordHash String?
  coverImage   String?
  category     String?
  brandName    String?
  brandLogoUrl String?
  brandPrimaryColor String?
  brandAccentColor  String?
  brandFont    String?
  brandFooter  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  slides       Slide[]
  viewLogs     ViewLog[]
  revisions    DeckRevision[]
  shareLinks   ShareLink[]
  collaborators DeckCollaborator[]
  comments     SlideComment[]
  tags         DeckTag[]
  favorites    Favorite[]
  @@index([ownerId])
  @@index([visibility])
  @@index([category])
}

model DeckRevision {
  id         String   @id @default(cuid())
  deckId     String
  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  authorId   String?
  title      String
  markdown   String
  slideCount Int
  createdAt  DateTime @default(now())
  @@index([deckId])
  @@index([createdAt])
}

model Slide {
  id        String   @id @default(cuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  order     Int
  content   Json
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  SlideComment[]
  @@unique([deckId, order])
  @@index([deckId])
}

model ShareLink {
  id            String    @id @default(cuid())
  token         String    @unique
  deckId        String
  deck          Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  label         String?
  passwordHash  String?
  allowDownload Boolean   @default(false)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  viewLogs      ViewLog[]
  @@index([deckId])
  @@index([token])
  @@index([expiresAt])
}

model DeckCollaborator {
  id        String           @id @default(cuid())
  deckId    String
  deck      Deck             @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CollaboratorRole @default(VIEWER)
  createdAt DateTime         @default(now())
  @@unique([deckId, userId])
  @@index([userId])
}

model SlideComment {
  id           String   @id @default(cuid())
  deckId       String
  deck         Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  slideId      String
  slide        Slide    @relation(fields: [slideId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body         String
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([deckId])
  @@index([slideId])
  @@index([authorId])
  @@index([resolvedAt])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  decks     DeckTag[]
}

model DeckTag {
  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([deckId, tagId])
  @@index([tagId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, deckId])
  @@index([deckId])
}

model ViewLog {
  id         String   @id @default(cuid())
  deckId     String
  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  shareLinkId String?
  shareLink   ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  slideOrder Int?
  ipAddress  String
  userAgent  String?
  referer    String?
  viewedAt   DateTime @default(now())
  @@index([deckId])
  @@index([shareLinkId])
  @@index([deckId, shareLinkId])
  @@index([userId])
  @@index([viewedAt])
  @@index([ipAddress])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
}

model SiteSetting {
  id                      Int      @id
  allowPublicRegistration Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}
