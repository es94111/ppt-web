{
  "name": "ppt-web",
  "version": "2.6.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "echo \"Next 16 removed 'next lint'. Add an ESLint flat config (eslint.config.mjs) + eslint/eslint-config-next to enable linting.\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "nanoid": "^3.3.17"
  }
}
